Do not apply guest RLIMIT_AS to the host

diff --git a/Source/Tools/LinuxEmulation/LinuxSyscalls/Syscalls/Passthrough.cpp b/Source/Tools/LinuxEmulation/LinuxSyscalls/Syscalls/Passthrough.cpp
index 11ff163..7bcfa4b 100644
--- a/Source/Tools/LinuxEmulation/LinuxSyscalls/Syscalls/Passthrough.cpp
+++ b/Source/Tools/LinuxEmulation/LinuxSyscalls/Syscalls/Passthrough.cpp
@@ -12,6 +12,7 @@ $end_info$
 
 #include <stdint.h>
 #include <sys/epoll.h>
+#include <sys/resource.h>
 
 namespace FEX::HLE {
 #ifdef ARCHITECTURE_arm64
@@ -334,7 +335,19 @@ static void RegisterCommon(FEX::HLE::SyscallHandler* Handler) {
   REGISTER_SYSCALL_IMPL(inotify_init1, SyscallPassthrough1<SYSCALL_DEF(inotify_init1)>);
   REGISTER_SYSCALL_IMPL(fanotify_init, SyscallPassthrough2<SYSCALL_DEF(fanotify_init)>);
   REGISTER_SYSCALL_IMPL(fanotify_mark, SyscallPassthrough5<SYSCALL_DEF(fanotify_mark)>);
-  REGISTER_SYSCALL_IMPL(prlimit_64, SyscallPassthrough4<SYSCALL_DEF(prlimit_64)>);
+  // FEX-static: FEX reserves far more virtual address space than any guest RLIMIT_AS
+  // anticipates (e.g. GTK's glycin image loaders run under `prlimit --as=...`), so
+  // applying a guest address-space limit to the host makes FEX itself crash. Accept the
+  // request without applying it; all other resources are passed through unchanged.
+  REGISTER_SYSCALL_IMPL(prlimit_64,
+                        [](FEXCore::Core::CpuStateFrame* Frame, pid_t pid, int resource, const struct rlimit* new_limit,
+                           struct rlimit* old_limit) -> uint64_t {
+                          if (resource == RLIMIT_AS) {
+                            new_limit = nullptr;
+                          }
+                          uint64_t Result = ::syscall(SYSCALL_DEF(prlimit_64), pid, resource, new_limit, old_limit);
+                          SYSCALL_ERRNO();
+                        });
   REGISTER_SYSCALL_IMPL(name_to_handle_at, SyscallPassthrough5<SYSCALL_DEF(name_to_handle_at)>);
   REGISTER_SYSCALL_IMPL(open_by_handle_at, SyscallPassthrough3<SYSCALL_DEF(open_by_handle_at)>);
   REGISTER_SYSCALL_IMPL(syncfs, SyscallPassthrough1<SYSCALL_DEF(syncfs)>);
@@ -443,7 +456,14 @@ namespace x64 {
     REGISTER_SYSCALL_IMPL_X64(mlockall, SyscallPassthrough1<SYSCALL_DEF(mlockall)>);
     REGISTER_SYSCALL_IMPL_X64(munlockall, SyscallPassthrough0<SYSCALL_DEF(munlockall)>);
     REGISTER_SYSCALL_IMPL_X64(adjtimex, SyscallPassthrough1<SYSCALL_DEF(adjtimex)>);
-    REGISTER_SYSCALL_IMPL_X64(setrlimit, SyscallPassthrough2<SYSCALL_DEF(setrlimit)>);
+    // FEX-static: see prlimit_64 above; RLIMIT_AS is accepted but not applied to the host.
+    REGISTER_SYSCALL_IMPL_X64(setrlimit, [](FEXCore::Core::CpuStateFrame* Frame, int resource, const struct rlimit* rlim) -> uint64_t {
+      if (resource == RLIMIT_AS) {
+        return 0;
+      }
+      uint64_t Result = ::syscall(SYSCALL_DEF(setrlimit), resource, rlim);
+      SYSCALL_ERRNO();
+    });
     REGISTER_SYSCALL_IMPL_X64(settimeofday, SyscallPassthrough2<SYSCALL_DEF(settimeofday)>);
     REGISTER_SYSCALL_IMPL_X64(readahead, SyscallPassthrough3<SYSCALL_DEF(readahead)>);
     REGISTER_SYSCALL_IMPL_X64(futex, SyscallPassthrough6<SYSCALL_DEF(futex)>);
diff --git a/Source/Tools/LinuxEmulation/LinuxSyscalls/x32/Info.cpp b/Source/Tools/LinuxEmulation/LinuxSyscalls/x32/Info.cpp
index 899de9b..86b3778 100644
--- a/Source/Tools/LinuxEmulation/LinuxSyscalls/x32/Info.cpp
+++ b/Source/Tools/LinuxEmulation/LinuxSyscalls/x32/Info.cpp
@@ -122,6 +122,10 @@ void RegisterInfo(FEX::HLE::SyscallHandler* Handler) {
       struct rlimit rlim64 {};
       FaultSafeUserMemAccess::VerifyIsReadable(rlim, sizeof(*rlim));
       rlim64 = *rlim;
+      // FEX-static: RLIMIT_AS is accepted but not applied to the host (see prlimit_64).
+      if (resource == RLIMIT_AS) {
+        return 0;
+      }
       uint64_t Result = ::setrlimit(resource, &rlim64);
       SYSCALL_ERRNO();
     });
